# ==============================================================================
# DBLP Project Git Ignore Configuration
# ==============================================================================

# --- Python Virtual Environment & Caches ---
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# --- Node / Frontend Artifacts ---
node_modules/
dashboard/node_modules/
dist/
dashboard/dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Large Database Files & Indexes ---
database/dblp.duckdb*
database/abstracts_cache.sqlite*
database/indexes/
*.duckdb*
*.sqlite*
*.faiss
*.npy
*.parquet

# --- Large Raw Datasets & Archives ---
*.xml
data/dblp.xml
data/compressed/dblp.xml.gz
*.gz
*.zip
*.tar
*.7z
*.jsonl
*.ndjson

# Local full-corpus exports and graph datasets (keep these out of Git).
/collaborations.txt
/com-dblp.ungraph.txt
data/raw/
data/derived/large/

# Retain small schema & benchmark data files in data/
!data/dblp.dtd
!data/benchmarks/
!data/benchmarks/*.csv
!data/compressed/*.md5

# --- Binary Tools & Heavy Dependencies ---
tools/
*.exe
*.dll
*.bin

# --- Logs & Runtime Temp Directories ---
logs/
*.log
.tmp/
.work/
.hallmark/
.impeccable/
backend/tests/dblp-test-*

# --- Backups & Local Overrides ---
*backup*
*.bak
.env
.env.local

# --- IDE & OS Metadata ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
